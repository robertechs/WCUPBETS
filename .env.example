# Solana (mainnet)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional dedicated server RPC (cron / build-tx); falls back to NEXT_PUBLIC
SOLANA_RPC_URL=

# Custodial vault (base58 pubkey shown in UI; secret only on server)
NEXT_PUBLIC_VAULT_PUBKEY=
VAULT_SECRET_KEY=

# Supabase (Project Settings → API; or Supabase MCP: get_project_url / get_publishable_keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron + admin (Bearer tokens)
CRON_SECRET=
ADMIN_TOKEN=
